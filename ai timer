import tkinter as tk
from tkinter import messagebox

# Time limit in seconds
TIME_LIMIT = 60

class ScreenTimeMonitor:
    def __init__(self, root):
        self.root = root
        self.root.title("AI Screen Time Monitor")
        self.root.geometry("500x300")

        self.remaining_time = TIME_LIMIT

        self.heading = tk.Label(
            root,
            text="AI Screen Time Monitor",
            font=("Arial", 20, "bold")
        )
        self.heading.pack(pady=20)

        self.timer_label = tk.Label(
            root,
            text=f"Time Remaining: {self.remaining_time} sec",
            font=("Arial", 16)
        )
        self.timer_label.pack(pady=20)

        self.update_timer()

    def update_timer(self):
        if self.remaining_time > 0:
            self.timer_label.config(
                text=f"Time Remaining: {self.remaining_time} sec"
            )
            self.remaining_time -= 1
            self.root.after(1000, self.update_timer)
        else:
            self.show_block_screen()

    def show_block_screen(self):
        messagebox.showwarning(
            "Warning",
            "Screen Time Limit Reached!"
        )

        for widget in self.root.winfo_children():
            widget.destroy()

        self.root.attributes("-fullscreen", True)

        block_label = tk.Label(
            self.root,
            text="ACCESS BLOCKED\n\nTake a Break!",
            font=("Arial", 30, "bold")
        )
        block_label.pack(expand=True)

        exit_button = tk.Button(
            self.root,
            text="Exit",
            font=("Arial", 16),
            command=self.root.destroy
        )
        exit_button.pack(pady=20)

root = tk.Tk()
app = ScreenTimeMonitor(root)
root.mainloop()
